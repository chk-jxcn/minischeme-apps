;;; gui.scm color schemes (theme.css parsing, day and night times) and infopages.scm helpers

(define css (theme-parse "/* a comment */ day { accent: #f00; text: rgb(1, 2, 3); }\n night, * { accent: #00ff00; }"))
(check "theme-parse: blocks" (map car css) '("day" "night" "*"))
(check "theme-block-get: own scheme" (theme-block-get css "day" "accent") "#f00")
(check "theme-block-get: another scheme" (theme-block-get css "night" "accent") "#00ff00")
(check "theme-block-get: * for the rest" (theme-block-get css "dusk" "accent") "#00ff00")
(check "theme-block-get: missing" (theme-block-get css "day" "border") #f)
(check "theme-parse: not text" (theme-parse #f) '())
(check "theme-trim" (theme-trim "  a b \t") "a b")
(check "theme-hex" (theme-hex "#1f80" 1 2) 31)
(check "theme-in-day?: inside" (theme-in-day? 600 420 1080) #t)
(check "theme-in-day?: before" (theme-in-day? 300 420 1080) #f)
(check "theme-in-day?: the end is out" (theme-in-day? 1080 420 1080) #f)
(check "theme-in-day?: over midnight" (theme-in-day? 60 1320 360) #t)
(check "theme-in-day?: over midnight, outside" (theme-in-day? 600 1320 360) #f)
(check "theme-day-of-year" (theme-day-of-year 2026 3 1) 60)
(check "theme-day-of-year: leap year" (theme-day-of-year 2024 3 1) 61)
(check "theme-day-of-year: 2000 leaps" (theme-day-of-year 2000 12 31) 366)
(check "theme-day-of-year: 1900 does not" (theme-day-of-year 1900 12 31) 365)

(check "info-bytes" (info-bytes 512) "512 B")
(check "info-bytes: KB" (info-bytes 1536) "1.5 KB")
(check "info-bytes: MB" (info-bytes 3145728) "3.00 MB")
(check "info-bytes: none" (info-bytes #f) "-")
(check "info-duration" (info-duration 3725) "01:02:05")
(check "info-duration: days" (info-duration (+ (* 3 86400) (* 4 3600) 300)) "3天 04:05")
(check "info-pad2" (info-pad2 3) "03")
(check "info-of" (info-of 1024 2048) "1.0 KB / 2.0 KB")

(check-done)
