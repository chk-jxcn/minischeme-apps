;;; gui.scm color schemes (theme.css parsing, day and night times) and infopages.scm helpers

(define css (theme-parse "/* a comment */ day { accent: #f00; text: rgb(1, 2, 3); }\n night, * { accent: #00ff00; }"))
(check "theme-parse: blocks" (map car css) '("day" "night" "*"))
(check "theme-block-get: own scheme" (theme-block-get css "day" "accent") "#f00")
(check "theme-block-get: another scheme" (theme-block-get css "night" "accent") "#00ff00")
(check "theme-block-get: * for the rest" (theme-block-get css "dusk" "accent") "#00ff00")
(check "theme-block-get: missing" (theme-block-get css "day" "border") #f)
(check "theme-parse: not text" (theme-parse #f) '())
(check "theme-trim" (theme-trim "  a b \t") "a b")
(check "theme-hex" (theme-hex "#1f80" 1 2) 31)
(check "theme-in-day?: inside" (theme-in-day? 600 420 1080) #t)
(check "theme-in-day?: before" (theme-in-day? 300 420 1080) #f)
(check "theme-in-day?: the end is out" (theme-in-day? 1080 420 1080) #f)
(check "theme-in-day?: over midnight" (theme-in-day? 60 1320 360) #t)
(check "theme-in-day?: over midnight, outside" (theme-in-day? 600 1320 360) #f)
(check "theme-day-of-year" (theme-day-of-year 2026 3 1) 60)
(check "theme-day-of-year: leap year" (theme-day-of-year 2024 3 1) 61)
(check "theme-day-of-year: 2000 leaps" (theme-day-of-year 2000 12 31) 366)
(check "theme-day-of-year: 1900 does not" (theme-day-of-year 1900 12 31) 365)

(check "info-bytes" (info-bytes 512) "512 B")
(check "info-bytes: KB" (info-bytes 1536) "1.5 KB")
(check "info-bytes: MB" (info-bytes 3145728) "3.00 MB")
(check "info-bytes: none" (info-bytes #f) "-")
(check "info-duration" (info-duration 3725) "01:02:05")
(check "info-duration: days" (info-duration (+ (* 3 86400) (* 4 3600) 300)) "3天 04:05")
(check "info-pad2" (info-pad2 3) "03")
(check "info-of" (info-of 1024 2048) "1.0 KB / 2.0 KB")

;; theme-uncomment: the pieces between comments (an open comment runs to the end)
(check "theme-uncomment" (theme-uncomment "a/* x */b /*y*/c") "ab c")
(check "theme-uncomment: none" (theme-uncomment "day { bg: #000; }") "day { bg: #000; }")
(check "theme-uncomment: open" (theme-uncomment "a /* b") "a ")
(check "theme-uncomment: only" (theme-uncomment "/**/") "")
(check "theme-uncomment: empty" (theme-uncomment "") "")

;; built-in schemes beyond day and night (applib 1.2): a ROM string each
(check "theme-preset-get" (theme-preset-get ";bg:#000000;fg:#fff;card_bg:bg;" "fg") "#fff")
(check "theme-preset-get: the first" (theme-preset-get ";bg:#000000;fg:#fff;" "bg") "#000000")
(check "theme-preset-get: an alias value" (theme-preset-get ";bg:#000000;card_bg:bg;" "card_bg") "bg")
(check "theme-preset-get: no prefix match" (theme-preset-get ";card_bg:#111;" "bg") #f)
(check "theme-preset-get: missing" (theme-preset-get ";bg:#000000;" "fg") #f)
(check "presets: each has every alias of night"
       (filter (lambda (p) (not (let all ((l THEME-NIGHT)) (or (null? l) (and (theme-preset-get (cddr p) (caar l)) (all (cdr l)))))))
               THEME-PRESETS)
       '())
(device-set-config! "theme" "night")
(device-set-config! "theme_night" "hc_dark")
(theme-load!)
(check "preset: in use" (list theme-scheme (theme-base-mode)) '("hc_dark" "night"))
(check "preset: its colors" (list (theme-lookup "bg") (theme-lookup "text_fg") (theme-lookup "card_bg")) '("#000000" "#ffffff" "bg"))
(device-set-config! "theme" "day")
(device-set-config! "theme_day" "dopamine_dark")
(theme-load!)
(check "preset: a dark one by day fills in from night" (list theme-mode (theme-base-mode)) '("day" "night"))
(theme-defaults! "night" '(("photo_bg" . "#010203")))
(check "preset: the app's defaults of its base mode" (theme-lookup "photo_bg") "#010203")
(fs-write "theme.css" "dopamine_dark { bg: #102030; }")   ; the app's own theme.css
(theme-load!)
(check "preset: theme.css overrides it" (theme-lookup "bg") "#102030")
(check "preset: the rest stays" (theme-lookup "text_fg") "#fff3fb")
(fs-delete "theme.css")
(device-set-config! "theme" "")
(device-set-config! "theme_day" "")
(device-set-config! "theme_night" "")

;; a new scheme for the mode in use is noticed at the next check (every 10 s), the files unchanged
(device-set-config! "theme" "night")
(device-set-config! "theme_night" "night")
(theme-load!)
(device-set-config! "theme_night" "ocean")
(let loop ((k 0)) (if (< k 10) (begin (theme-tick!) (loop (+ k 1)))))
(check "theme-tick!: a new scheme name" theme-scheme "ocean")
(device-set-config! "theme" "")
(device-set-config! "theme_night" "")
(theme-load!)

(check-done)
