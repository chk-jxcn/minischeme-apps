;;; applib section 2 (strings and numbers), 3 (proxy items) and 4 (series-range)

(check "str-split" (str-split "a,b,,c" #\,) '("a" "b" "" "c"))
(check "str-split: one field" (str-split "abc" #\,) '("abc"))
(check "str-split: empty" (str-split "" #\,) '(""))
(check "str-part" (str-part "x|y|z" #\| 1) "y")
(check "str-part: missing" (str-part "x|y" #\| 5) "")
(check "str-empty? #f" (str-empty? #f) #t)
(check "str-empty? empty" (str-empty? "") #t)
(check "str-empty? text" (str-empty? "a") #f)
(check "str-starts?" (str-starts? "weather.front" "weather") #t)
(check "str-starts? longer prefix" (str-starts? "ab" "abc") #f)
(check "str-contains?" (str-contains? "hello world" "o w") #t)
(check "str-contains? missing" (str-contains? "hello" "xyz") #f)
(check "str-contains? at the end" (str-contains? "hello" "llo") #t)
(check "url-encode" (url-encode "a b&c=d/x-y_z.~,") "a%20b%26c%3Dd%2Fx-y_z.~,")
(check "url-encode: UTF-8 bytes" (url-encode "中") "%E4%B8%AD")
(check "int->str" (int->str -12) "-12")
(check "pad2" (pad2 7) "07")
(check "pad2: two digits" (pad2 12) "12")
(check "fixed->str" (fixed->str 1234 2) "12.34")
(check "fixed->str: negative" (fixed->str -5 1) "-0.5")
(check "fixed->str: leading zeros" (fixed->str 7 2) "0.07")
(check "fixed->str: no digits" (fixed->str 5 0) "5")
(check "fixed->str: no value" (fixed->str #f 2) "--")
(check "make-string-of" (make-string-of #\x 3) "xxx")
(check "clamp: high" (clamp 5 0 3) 3)
(check "clamp: low" (clamp -1 0 3) 0)
(check "clamp: inside" (clamp 2 0 3) 2)
(check "list-min" (list-min '(3 1 2)) 1)
(check "list-max" (list-max '(3 1 2)) 3)
(check "list-sum" (list-sum '(3 1 2)) 6)
(check "list-sum: empty" (list-sum '()) 0)
(check "take" (take '(1 2 3) 2) '(1 2))
(check "take: more than there are" (take '(1) 5) '(1))
(check "take: none" (take '(1 2) 0) '())
(check "series-range: empty" (series-range '() 10) (cons 0 10))

;; Proxy items: #(type a b c d e), absent fields #f
(define it1 (vector 'day "周一" "20,30" "1234" #f "x"))
(define it2 (vector 'day "周二" "1,2,3" "5" "d" ""))
(define it3 (vector 'now "晴" #f #f #f #f))
(define items (list it1 it2 it3))
(check "it-t" (it-t it1) 'day)
(check "it-a" (it-a it1) "周一")
(check "it-d: absent is empty" (it-d it1) "")
(check "it-ints" (it-ints it1 2) '(20 30))
(check "it-ints: absent" (it-ints it3 2) '())
(check "it-int" (it-int it2 3) 5)
(check "it-fixed: absent" (it-fixed it3 3 2) #f)
(check "it-key: a base key" (it-key it2 "d") "d")
(check "it-key: unknown" (it-key it2 "topic") "")
(check "items-find" (items-find items "day") it1)
(check "items-find: none" (items-find items "night") #f)
(check "items-find: no items" (items-find #f "day") #f)
(check "items-all" (items-all items "day") (list it1 it2))
(check "items-all: no items" (items-all '() "day") '())
(check "items-where" (items-where items "day" 1 "周二") it2)
(check "items-where: none" (items-where items "now" 1 "雨") #f)

(check-done)
