;;; applib section 5 and 8: pages, settings, the carousel's seconds, turning pages

(define (render items) #t)

(check "app-config: missing" (app-config "city" "auto") "auto")
(device-set-config! "city" "")
(check "app-config: empty is missing" (app-config "city" "auto") "auto")
(device-set-config! "city" "深圳")
(check "app-config" (app-config "city" "auto") "深圳")

;; one value per page, at least 3 s; the last one repeats
(device-set-config! "carousel" "1")
(device-set-config! "carousel_seconds" "15,4,1")
(app-define! "测试" (list (app-local-page "一" render) (app-local-page "二" render) (app-local-page "三" render)))
(check "app-npages" (app-npages) 3)
(check "first page" app-page-index 0)
(check "app-local?" (app-local? 0) #t)
(check "seconds of page 1" (app-page-seconds 0) 15)
(check "seconds of page 2" (app-page-seconds 1) 4)
(check "seconds: at least 3" (app-page-seconds 2) 3)
(check "seconds: the last repeats" (app-page-seconds 5) 3)
(app-next-page!)
(check "app-next-page!" app-page-index 1)
(app-next-page!)
(app-next-page!)
(check "app-next-page!: wraps" app-page-index 0)
(app-goto! 2)
(check "app-goto!" app-page-index 2)
(check "app-cur" (vector-ref (app-cur) 0) "三")

;; carousel off, or a single page: no carousel
(device-set-config! "carousel" "0")
(check "app-carousel-config: off" (app-carousel-config) #f)
(device-set-config! "carousel" "1")
(device-set-config! "carousel_seconds" "")
(check "app-carousel-config: the default" (app-carousel-config) '(10))
(app-define! "单页" (list (app-local-page "一" render)))
(check "one page: no carousel" app-carousel #f)
(check "no carousel: 10 s" (app-page-seconds 0) 10)

;; a page with a URL: the url-proc is called once, at app-define!
(define url-calls 0)
(app-define! "数据" (list (app-page "首页" (lambda () (set! url-calls (+ url-calls 1)) "http://x/app/weather") 60000 render)))
(check "url-proc called once" url-calls 1)
(check "app-local?: a feed page" (app-local? 0) #f)

;; show_pages: the pages shown, in order, a page possibly several times; English page
;; names (page_ids, set by the build), numbers or the pages' own names
(device-set-config! "carousel" "1")
(device-set-config! "carousel_seconds" "20,5")
(app-page-ids! '("today" "month" "moon"))
(device-set-config! "show_pages" " moon, today ,moon, 2, nosuch, 今日 ")
(app-define! "顺序" (list (app-local-page "今日" render) (app-local-page "月历" render) (app-local-page "月相" render)))
(check "show_pages: the order" (vector->list app-order) '(2 0 2 1 0))
(check "show_pages: starts at its first" app-page-index 2)
(check "show_pages: the carousel's seconds per place" (app-page-seconds app-order-pos) 20)
(app-next-page!)
(check "show_pages: next" (list app-order-pos app-page-index) '(1 0))
(check "show_pages: seconds of the second place" (app-page-seconds app-order-pos) 5)
(app-next-page!)
(check "show_pages: a page again" (list app-order-pos app-page-index) '(2 2))
(app-next-page!)
(app-next-page!)
(app-next-page!)
(check "show_pages: wraps" (list app-order-pos app-page-index) '(0 2))
(app-goto! 1)
(check "app-goto!: its first place" (list app-order-pos app-page-index) '(3 1))
(app-goto! 2)
(app-next-page!)
(check "app-goto!: the order goes on" (list app-order-pos app-page-index) '(1 0))
(app-page-ids! '())
(device-set-config! "show_pages" "1,1")
(app-define! "重复" (list (app-local-page "一" render) (app-local-page "二" render)))
(check "show_pages: one page twice" (vector->list app-order) '(0 0))
(check "show_pages: two places, a carousel" (pair? app-carousel) #t)
(device-set-config! "show_pages" "3")
(app-define! "单页" (list (app-local-page "一" render) (app-local-page "二" render) (app-local-page "三" render)))
(check "show_pages: one place, no carousel" (list (vector->list app-order) app-page-index app-carousel) '((2) 2 #f))
(app-next-page!)
(check "show_pages: one place stays" app-page-index 2)
(device-set-config! "show_pages" "nosuch, 9")
(app-define! "全部" (list (app-local-page "一" render) (app-local-page "二" render)))
(check "show_pages: none known -> every page" (vector->list app-order) '(0 1))
(device-set-config! "show_pages" "")
(check "str-trim" (list (str-trim "  a b ") (str-trim "") (str-trim "   ")) '("a b" "" ""))

;; a page not shown is not prefetched
(device-set-config! "show_pages" "2")
(app-define! "预取" (list (app-page "甲" (lambda () "http://x/app/a") 60000 render)
                          (app-page "乙" (lambda () "http://x/app/b") 60000 render)))
(set! app-cache (list (vector "http://x/app/b" '() "10:00" 0)))
(check "prefetch: the hidden page is never fetched" (app-prefetch-next!) #f)
(device-set-config! "show_pages" "")

(check-done)
