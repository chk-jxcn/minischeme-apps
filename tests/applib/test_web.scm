;;; appweb.scm: the Scheme side of an app's web page (form fields in, JSON out)

(check "web-decode" (web-decode "a+b%41") "a bA")
(check "web-decode: UTF-8 bytes" (web-decode "%E4%B8%AD%e6%96%87") "中文")
(check "web-decode: a cut escape stays" (web-decode "100%") "100%")
(check "web-decode: not hex stays" (web-decode "%zz") "%zz")
(check "web-field" (web-field "a=1&b=x%20y&c" "b") "x y")
(check "web-field: no value" (web-field "a=1&b=x%20y&c" "c") "")
(check "web-field: missing" (web-field "a=1" "d") #f)
(check "web-field: no body" (web-field #f "a") #f)
(check "web-field: a longer key is another field" (web-field "ab=1&a=2" "a") "2")
(check "web-field-int" (web-field-int "n=42" "n" 0) 42)
(check "web-field-int: not a number" (web-field-int "n=x" "n" 7) 7)
(check "web-field-int: missing" (web-field-int "" "n" 7) 7)

(check "web-json: string escapes" (web-json "a\"b\\c\nd") "\"a\\\"b\\\\c\\nd\"")
(check "web-json: control character" (web-json (list->string (list (integer->char 1)))) "\"\\u0001\"")
(check "web-json: object" (web-json (list (cons 'a 1) (cons "b" (vector 1 2)) (cons 'c #t) (cons 'd '())))
       "{\"a\":1,\"b\":[1,2],\"c\":true,\"d\":[]}")
(check "web-json: list" (web-json (list 1 "x" #f)) "[1,\"x\",false]")
(check "web-json: symbol" (web-json 'on) "\"on\"")
(check "web-json: UTF-8 text unchanged" (web-json "天气") "\"天气\"")
(check "web-ok" (web-ok (cons 'n 2)) "{\"success\":true,\"n\":2}")
(check "web-error" (web-error "bad") "{\"success\":false,\"error\":\"bad\"}")
(check "web-join" (web-join (list "a" "b" "c") ", ") "a, b, c")
(check "web-join: empty" (web-join '() ",") "")

(check-done)
